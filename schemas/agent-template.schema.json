{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/realrevi/agentflow/schemas/agent-template.schema.json",
  "title": "AgentFlow agent template",
  "description": "One source for an AI agent, rendered by AgentFlow into Claude Code, Codex CLI, Gemini CLI, Cursor and AgentFlow files. See docs/agent-template.md. AgentFlow also checks that question ids are unique, every {{placeholder}} names a question or a built-in (name, description, workspaceName), and defaults fit their question type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "description", "version", "instructions"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\n]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
    },
    "character": { "type": "string" },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "instructions": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "questions": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/question" } },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claudeCode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": { "type": "array", "items": { "type": "string" } },
            "model": { "type": "string" }
          }
        },
        "codex": { "type": "object", "additionalProperties": false },
        "gemini": { "type": "object", "additionalProperties": false },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "globs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "alwaysApply": { "type": "boolean" }
          }
        },
        "agentflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permissionMode": { "enum": ["ask", "autoEdit", "readOnly"] },
            "tools": {
              "type": "array",
              "items": {
                "enum": [
                  "list_dir",
                  "read_file",
                  "glob",
                  "search",
                  "write_file",
                  "edit_file",
                  "run_command"
                ]
              }
            },
            "provider": { "type": "string" },
            "model": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "help": { "type": "string" },
        "type": {
          "enum": ["text", "multiline", "choice", "multiChoice", "color", "font", "boolean"]
        },
        "default": { "type": ["string", "boolean", "array"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "detect": {
          "enum": [
            "languages",
            "packageManager",
            "testFramework",
            "testCommand",
            "uiFramework",
            "colors",
            "fonts",
            "spacing",
            "breakpoints"
          ]
        },
        "required": { "type": "boolean" },
        "group": { "type": "string" }
      }
    }
  }
}

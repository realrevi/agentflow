{
  "version": 1,
  "sources": [
    {
      "id": "anthropic-skills",
      "name": "Anthropic Skills",
      "repo": "anthropics/skills",
      "branch": "main",
      "license": "per-item",
      "entries": [
        {
          "format": "claudeSkill",
          "include": ["skills/*/SKILL.md"],
          "exclude": [
            "skills/docx/**",
            "skills/pdf/**",
            "skills/pptx/**",
            "skills/xlsx/**",
            "skills/doc-coauthoring/**"
          ]
        }
      ]
    },
    {
      "id": "openai-skills",
      "name": "OpenAI Skills",
      "repo": "openai/skills",
      "branch": "main",
      "license": "per-item",
      "entries": [
        {
          "format": "claudeSkill",
          "include": ["skills/.curated/*/SKILL.md"],
          "exclude": ["skills/.curated/figma*/**", "skills/.curated/notion-*/**"]
        }
      ]
    },
    {
      "id": "superpowers",
      "name": "Superpowers",
      "repo": "obra/superpowers",
      "branch": "main",
      "license": "MIT",
      "entries": [{ "format": "claudeSkill", "include": ["skills/*/SKILL.md"] }]
    },
    {
      "id": "wshobson-agents",
      "name": "wshobson agents",
      "repo": "wshobson/agents",
      "branch": "main",
      "license": "MIT",
      "entries": [
        { "format": "claudeSubagent", "include": ["plugins/*/agents/*.md"] },
        { "format": "claudeSkill", "include": ["plugins/*/skills/*/SKILL.md"] }
      ]
    },
    {
      "id": "voltagent-claude",
      "name": "Awesome Claude Code Subagents",
      "repo": "VoltAgent/awesome-claude-code-subagents",
      "branch": "main",
      "license": "MIT",
      "entries": [
        {
          "format": "claudeSubagent",
          "include": ["categories/*/*.md"],
          "exclude": ["categories/*/README.md"]
        }
      ]
    },
    {
      "id": "voltagent-codex",
      "name": "Awesome Codex Subagents",
      "repo": "VoltAgent/awesome-codex-subagents",
      "branch": "main",
      "license": "MIT",
      "entries": [{ "format": "codexAgent", "include": ["categories/*/*.toml"] }]
    },
    {
      "id": "awesome-cursorrules",
      "name": "Awesome Cursor Rules",
      "repo": "PatrickJS/awesome-cursorrules",
      "branch": "main",
      "license": "CC0-1.0",
      "entries": [{ "format": "cursorRule", "include": ["rules/*.mdc"] }]
    },
    {
      "id": "cursor-rules-mdc",
      "name": "Awesome Cursor Rules (MDC)",
      "repo": "sanjeed5/awesome-cursor-rules-mdc",
      "branch": "main",
      "license": "CC0-1.0",
      "entries": [{ "format": "cursorRule", "include": ["rules-mdc/*.mdc"] }]
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "repo": "google-gemini/gemini-cli",
      "branch": "main",
      "license": "Apache-2.0",
      "entries": [
        { "format": "geminiCommand", "include": [".gemini/commands/**/*.toml"] },
        { "format": "claudeSkill", "include": [".gemini/skills/*/SKILL.md"] }
      ]
    }
  ]
}

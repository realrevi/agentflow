# Normalize line endings: LF in the repo and in every working copy (rustfmt and Prettier
# expect LF; core.autocrlf=true on Windows would otherwise check out CRLF).
* text=auto eol=lf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zst binary
